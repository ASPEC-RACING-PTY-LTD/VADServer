.github
.claude
.dev-data
.env
.env.*
!.env.example
backups
bin
dist
*.exe
*.db
*.db-wal
*.db-shm
**/node_modules
web/dist
web/test-results
web/playwright-report
web/blob-report
web/tsconfig.tsbuildinfo
desktop
